# Endpoint de saúde real do serviço de IA da ARAH.
# Deve retornar JSON indicando que o modelo está pronto, por exemplo:
#   { "status": "ready" }
#   { "status": "ok" }
#   { "healthy": true }
#
# Sem esta variável, /api/health retorna status "unknown" de propósito:
# a URL pública /preview é apenas a interface, não prova que o backend está ativo.
ARAH_HEALTH_URL=
